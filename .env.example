# Watchdog AI Environment Variables
# Copy this file to .env and fill in your values

# Climatiq API Key for sustainability calculations
# Get your key at: https://www.climatiq.io/
CLIMATIQ_API_KEY=your_climatiq_api_key_here

# Optional: Set the region for carbon calculations
# Options: global_average, us_average, eu_average, renewable
WATCHDOG_REGION=global_average
